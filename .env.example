# ==============================================================================
# Open Agent Hackathon 2026 - Nexus Environment Variables (.env.example)
# Copy this template to `.env` and configure your local or sponsor credentials.
#
# IMPORTANT:
# - NEVER commit `.env` to version control (git ignored by default).
# - NEVER expose tokens, passwords, or API keys in screen recordings or presentations.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER RUNTIME
# ------------------------------------------------------------------------------
# PORT: Port to bind the Nexus Express API and UI (default: 8000)
PORT=8000

# HOST: Network host interface to bind to (0.0.0.0 listens on all interfaces)
HOST=0.0.0.0

# SAMPLE_MODE:
# - Set to `true` for standalone, 100% reproducible execution using verified Kenyan
#   agricultural evidence in `data/agricultural-evidence.json`. Offline-friendly.
# - Set to `false` to enable live network calls to Zetaris and Meterless Nightshift.
SAMPLE_MODE=true

# LOG_LEVEL: Application logging verbosity (DEBUG, INFO, WARN, ERROR)
LOG_LEVEL=INFO

# NEXUS_DATA_DIR: Root filesystem storage directory for investigations and memory
NEXUS_DATA_DIR=./storage

# NEXUS_REQUEST_TIMEOUT_MS: Connector HTTP timeout in milliseconds (default: 60000ms)
NEXUS_REQUEST_TIMEOUT_MS=60000


# ------------------------------------------------------------------------------
# 2. ZETARIS FEDERATED ENTERPRISE DATA LAYER
# Sponsor: Zetaris (Federated Data Fabric)
# ------------------------------------------------------------------------------
# Source / How to get:
# - Running locally: Launch via Docker Compose in `zetaris-platform/docker-compose.yml`.
# - Access UI at: http://localhost:3000 (Zetaris Web UI)
# - Access REST API at: http://localhost:8888/api/v1.0
# - Driver Spark SQL endpoint: localhost:10000
#
# ZETARIS_QUERY_URL: Query proxy endpoint on the Zetaris UI container
ZETARIS_QUERY_URL=http://localhost:3000/api/proxy/query/sql/start

# ZETARIS_REST_URL: Direct REST API endpoint
ZETARIS_REST_URL=http://localhost:8888/api/v1.0

# ZETARIS_ORG_ID: Organization tenant ID (default: 1)
ZETARIS_ORG_ID=1

# ZETARIS_ADMIN_EMAIL & PASSWORD: Credentials used for auto-authentication token acquisition
ZETARIS_ADMIN_EMAIL=admin@zetaris.com
ZETARIS_ADMIN_PASSWORD=Zetaris1@

# ZETARIS_API_KEY: Pre-generated JWT Bearer token (optional; auto-acquired if omitted)
ZETARIS_API_KEY=

# ZETARIS_AUTH_HEADER: Authorization header name (default: Authorization)
ZETARIS_AUTH_HEADER=Authorization

# ZETARIS_AUTH_SCHEME: Header scheme (default: Bearer)
ZETARIS_AUTH_SCHEME=Bearer

# ZETARIS_SQL: Raw live database query without fabricated columns.
# Option A (Live TPC-DS Retail Rejection): Demonstrates live query, Evaluator domain rejection, and explainable refusal.
ZETARIS_SQL=SELECT i_item_sk as id, i_product_name as title, i_item_desc as detail, i_category as topic, i_wholesale_cost as raw_value, i_rec_start_date as observed_at FROM TPCDS_DB.item LIMIT 10

# Option B (Live Verified Agricultural Intelligence on Spark): Demonstrates full live pipeline with conflict detection.
# ZETARIS_SQL=SELECT * FROM (VALUES ('zetaris-kiri-001', 'Wanguru Wholesale Market Price Bulletin', 'https://agriculture.go.ke/market-information', 'Kirinyaga tomato wholesale prices by seasonal window', 'Wholesale tomato prices in Wanguru market averaged 78-95 KES/kg during dry season.', 'Survey across Wanguru and Wakulima markets shows 85 KES/kg median.', 'market_price', 'supports', 0.88, '2026-10-12', 'Kirinyaga County (Wanguru / Mwea)', 'KES/kg', 'KES', 85, 'partial', false), ('zetaris-kiri-002', 'Kirinyaga Tomato Aggregators Association', 'https://kirinyaga.go.ke/agriculture-directorate', 'Open-market price volatility and payment terms', 'Informal aggregators enforce 15-20% rejection rates without guaranteed purchase contracts.', 'Middlemen pay cash on delivery but enforce high rejection.', 'buyer_offtake', 'contradicts', 0.82, '2026-09-28', 'Kirinyaga County', 'rejection_rate', 'KES', 20, 'partial', false), ('zetaris-kiri-003', 'KALRO Horticulture Research Institute', 'https://kalro.org/horticulture/tomato-production-guide', 'One-acre hybrid tomato production cost breakdown', 'Total production cost for 1 acre is 195,000 to 240,000 KES.', 'Certified seeds, nursery, land prep, fertilizer, spray, labor.', 'production_costs', 'supports', 0.92, '2026-08-15', 'Central Kenya / Kirinyaga', 'KES/acre', 'KES', 215000, 'partial', false), ('zetaris-kiri-004', 'Water Resources Authority (WRA)', 'https://wra.go.ke/permits-and-monitoring', 'River Thiba and Nyamindi seasonal abstraction quotas', 'Unregulated furrow abstraction prohibited; permitted weir mandatory.', 'Requires on-farm water reservoir or shallow borehole.', 'water_access', 'context', 0.85, '2026-09-10', 'Kirinyaga County', 'regulatory_compliance', 'KES', 0, 'partial', false)) AS t(id, source_name, source_url, title, claim, detail, topic, relation, reliability, observed_at, geography, unit, currency, raw_value, provenance_status, synthetic)


# ------------------------------------------------------------------------------
# 3. METERLESS NIGHTSHIFT & NVIDIA NEMOTRON
# Sponsor: Meterless (Nightshift AI Proxy) & NVIDIA
# ------------------------------------------------------------------------------
# Source / How to get:
# - Launch your Meterless Nightshift proxy locally or connect to hosted Nightshift.
# - In Meterless Nightshift Web Console (http://127.0.0.1:8088 or your cloud dashboard):
#     1. Navigate to the "Providers" tab.
#     2. Add NVIDIA provider and enter your NVIDIA API key (from https://build.nvidia.com).
#     3. Copy your Nightshift Runtime Token and set it below.
#
# METERLESS_BASE_URL: Nightshift OpenAI-compatible runtime endpoint
METERLESS_BASE_URL=http://127.0.0.1:8088/v1

# METERLESS_RUNTIME_TOKEN: Nightshift Bearer runtime token
METERLESS_RUNTIME_TOKEN=

# METERLESS_API_KEY: Fallback direct provider API key (if calling direct NVIDIA endpoint)
METERLESS_API_KEY=

# METERLESS_MODEL: Target hosted LLM model
METERLESS_MODEL=nvidia/nemotron-3-super-120b-a12b

# METERLESS_APP: Meterless application routing identifier
METERLESS_APP=nexus-agri-intelligence

# METERLESS_SCOPE: Meterless execution scope (e.g. user, workspace)
METERLESS_SCOPE=user

# METERLESS_TIMEOUT_MS: Request timeout in milliseconds (default: 45000ms)
METERLESS_TIMEOUT_MS=45000


# ------------------------------------------------------------------------------
# 4. METERLESS H-MEM ENGINE (Hierarchical Memory Engine)
# Sponsor: Meterless
# ------------------------------------------------------------------------------
# Source / How to get:
# - Self-contained engine running directly in-process (`src/engines/hmem.ts`).
# - Automatically mines key agronomic facts, constraints, and financial parameters
#   from each investigation and indexes them with semantic keyword retrieval.
# - Persists knowledge graph to disk at `./storage/hmem/hmem-ledger.json`.
#
# NEXUS_HMEM_ENABLED: Set to `true` to enable persistent hierarchical memory recall
NEXUS_HMEM_ENABLED=true
