# ==============================================================================
# Open Agent Hackathon 2026 - Nexus Environment Variables (.env.example)
# Copy this file to .env and configure your local or sponsor credentials.
# NEVER commit .env to version control or expose tokens in demo videos/logs.
# ==============================================================================

# Runtime Behavior
PORT=8000
HOST=0.0.0.0
SAMPLE_MODE=true
LOG_LEVEL=INFO
NEXUS_DATA_DIR=./storage
NEXUS_REQUEST_TIMEOUT_MS=20000

# ------------------------------------------------------------------------------
# Zetaris (Data Layer)
# Running locally via Docker or remote cluster.
# ------------------------------------------------------------------------------
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_QUERY_URL=http://localhost:3000/api/proxy/query/sql/start
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=
ZETARIS_AUTH_HEADER=Authorization
ZETARIS_AUTH_SCHEME=Bearer
ZETARIS_SQL=SELECT * FROM nexus_opportunity_evidence LIMIT 50

# ------------------------------------------------------------------------------
# Meterless Nightshift (Primary AI Provider) & NVIDIA Nemotron
# Model calls route through Meterless Nightshift to hosted NVIDIA endpoints.
# ------------------------------------------------------------------------------
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=
METERLESS_API_KEY=
METERLESS_MODEL=nvidia/nemotron-3-super-120b-a12b
METERLESS_APP=nexus-agri-intelligence
METERLESS_SCOPE=user
METERLESS_TIMEOUT_MS=45000

# ------------------------------------------------------------------------------
# Meterless Engine (H-MEM: Hierarchical Memory Engine)
# Self-contained active engine with disk persistence and relevance retrieval.
# ------------------------------------------------------------------------------
NEXUS_HMEM_ENABLED=true
