{
  "name": "nexus-agricultural-intelligence",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Nexus: evidence-driven agricultural market intelligence and decision support for Open Agent Hackathon 2026",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "start:dev": "tsx src/server.ts",
    "run": "tsx run.js",
    "run:sample": "SAMPLE_MODE=true tsx run.js input_examples/example_1.json",
    "test": "tsx --test tests/*.test.ts",
    "test:hmem": "tsx --test tests/hmem.test.ts",
    "test:decision": "tsx --test tests/decision.test.ts",
    "test:e2e": "node --experimental-websocket tests/frontend_e2e.mjs",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
